# Google Sheets ID (linkdagi uzun kod, masalan:
# https://docs.google.com/spreadsheets/d/BU_YERDA_ID/edit  <-- shu ID)
GOOGLE_SHEET_ID=

# Google Service Account credentials JSON fayli (README'dagi qo'llanmaga qarang)
GOOGLE_CREDENTIALS_FILE=credentials.json

# Google Sheets ichidagi list (sheet) nomi - "Визиты" jadvali joylashgan varaq
VIZITLAR_SHEET_NAME=Vizitlar

# Telegram bot tokeni (@BotFather'dan olinadi)
TELEGRAM_BOT_TOKEN=

# Menejerning Telegram chat_id'si (@userinfobot orqali bilib olish mumkin)
MANAGER_CHAT_ID=

# Погрешность (GPS xatosi) shu metrdan katta bo'lsa - xato deb hisoblanadi
MAX_POGRESHNOST_METERS=150

# Фото soni 0 bo'lsa ham xato deb hisoblansinmi? (true/false)
CHECK_ZERO_PHOTO=true

# Doimiy rejimda necha soniyada bir marta tekshirish (1800 = 30 daqiqa)
CHECK_INTERVAL_SECONDS=1800

# Bitta do'kondan keyingi do'konga kamida shuncha daqiqa o'tishi kerak
# (undan kam bo'lsa "juda tez, real emas" deb xato hisoblanadi)
MIN_TRAVEL_MINUTES=3

# Tizimingizdagi sana/vaqt formati (odatda o'zgartirish shart emas)
DATETIME_FORMAT=%d.%m.%Y %H:%M:%S

# RAILWAY UCHUN MUHIM: yuqoridagi GOOGLE_CREDENTIALS_FILE o'rniga, credentials.json
# faylining ICHIDAGI BUTUN matnni (bitta qatorga tekislab) shu yerga qo'ying:
# GOOGLE_CREDENTIALS_JSON={"type": "service_account", "project_id": "...", ...}
GOOGLE_CREDENTIALS_JSON=
